rule controller_defaults_disabled {
    Parameters.ControllerEnabled.Default == 'false'
}

rule lambda_is_bounded {
    Resources.ExpiryFunction.Properties.Runtime == 'python3.12'
    Resources.ExpiryFunction.Properties.Timeout <= 30
    Resources.ExpiryFunction.Properties.MemorySize == 128
    Resources.ExpiryFunction.Properties.ReservedConcurrentExecutions not exists
}

rule recovery_log_is_retained_and_bounded {
    Resources.ExpiryLogGroup.DeletionPolicy == 'Retain'
    Resources.ExpiryLogGroup.UpdateReplacePolicy == 'Retain'
    Resources.ExpiryLogGroup.Properties.RetentionInDays == 30
    Resources.ExpiryFunction.Properties.LoggingConfig.LogGroup.Ref == 'ExpiryLogGroup'
}

rule controller_resource_tags_use_cloudformation_safe_keys {
    Resources.ExpiryLogGroup.Properties.Tags.*.Key IN ['SkaldAndStone-Product', 'SkaldAndStone-SessionId']
    Resources.ExpiryFunction.Properties.Tags.*.Key IN ['SkaldAndStone-Product', 'SkaldAndStone-SessionId']
}

rule role_has_only_expected_scoped_statements {
    Resources.ExpiryRole.Properties.Policies.*.PolicyDocument.Statement.*.Sid IN ['ExactRuntimeStack', 'PassDeletionRole', 'OwnSchedule', 'OwnLogs']
    Resources.ExpiryRole.Properties.Policies.*.PolicyDocument.Statement.*.Effect == 'Allow'
    Resources.ExpiryRole.Properties.Policies.*.PolicyDocument.Statement.*.Resource exists
}

rule cloudformation_uses_a_dedicated_deletion_role {
    Resources.RuntimeDeletionRole.Type == 'AWS::IAM::Role'
    Resources.RuntimeDeletionRole.Properties.AssumeRolePolicyDocument.Statement.*.Principal.Service == 'cloudformation.amazonaws.com'
    Resources.RuntimeDeletionRole.Properties.Policies.*.PolicyDocument.Statement.*.Sid IN ['ReadDeletionState', 'DeleteRegionalRuntimeResources', 'SnapshotExactDatabase', 'DeleteExactEcsWorkloads', 'DeregisterRuntimeTaskDefinitions', 'DeleteExactRuntimeRoles', 'DeleteDatabaseAdminLogGroup', 'DeleteRuntimeCloudFrontResources']
    Resources.RuntimeDeletionRole.Properties.Policies.*.PolicyDocument.Statement.*.Effect == 'Allow'
    Resources.RuntimeDeletionRole.Properties.Policies.*.PolicyDocument.Statement.*.Resource exists
    Resources.ExpiryFunction.Properties.Environment.Variables.DELETION_ROLE_ARN.'Fn::GetAtt' == 'RuntimeDeletionRole.Arn'
}

rule final_database_snapshot_is_exact_and_region_bounded {
    Resources.RuntimeDeletionRole.Properties.Policies.*.PolicyDocument.Statement[ Sid == 'SnapshotExactDatabase' ] {
        Action == 'rds:CreateDBSnapshot'
        Resource == [
            { 'Fn::Sub': 'arn:${AWS::Partition}:rds:${ExpectedRegion}:${ExpectedAccount}:db:kall-alpha-postgres' },
            { 'Fn::Sub': 'arn:${AWS::Partition}:rds:${ExpectedRegion}:${ExpectedAccount}:snapshot:kall-sandbox-29f1815c16c9-snapshot-database-*' }
        ]
        Condition.StringEquals.'aws:RequestedRegion'.Ref == 'ExpectedRegion'
    }
}

rule database_admin_log_delete_is_exact {
    Resources.RuntimeDeletionRole.Properties.Policies.*.PolicyDocument.Statement[ Sid == 'DeleteDatabaseAdminLogGroup' ] {
        Action == 'logs:DeleteLogGroup'
        Resource.'Fn::Sub' == 'arn:${AWS::Partition}:logs:${ExpectedRegion}:${ExpectedAccount}:log-group:/skaldandstone/alpha/kall-database-admin'
    }
}

rule task_definition_deregistration_is_the_only_wildcard_ecs_mutation {
    Resources.RuntimeDeletionRole.Properties.Policies.*.PolicyDocument.Statement[ Sid == 'DeregisterRuntimeTaskDefinitions' ] {
        Action == 'ecs:DeregisterTaskDefinition'
        Resource == '*'
        Condition.StringEquals.'aws:RequestedRegion'.Ref == 'ExpectedRegion'
    }
}

rule schedule_is_frequent_and_retry_bounded {
    Resources.ExpiryRule.Properties.ScheduleExpression == 'rate(5 minutes)'
    Resources.ExpiryRule.Properties.Targets.*.RetryPolicy.MaximumEventAgeInSeconds == 300
    Resources.ExpiryRule.Properties.Targets.*.RetryPolicy.MaximumRetryAttempts == 2
}
