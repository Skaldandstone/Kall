# Core runtime
APP_ENV=production
APP_SECRET_KEY=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:5432/kall
DATABASE_SSL_MODE=verify-full
DATABASE_SSL_ROOT_CERT=/etc/ssl/certs/aws-rds-us-east-2-bundle.pem
FRONTEND_URL=https://app.example.com
AUTO_CREATE_TABLES=false

# Encrypts EEO, authorization, and other sensitive profile fields.
SENSITIVE_DATA_ENCRYPTION_KEY=REPLACE_WITH_A_FERNET_COMPATIBLE_KEY

# Stripe test configuration. Replace with live values only after a full sandbox test.
STRIPE_SECRET_KEY=sk_test_REPLACE_ME
STRIPE_WEBHOOK_SECRET=whsec_REPLACE_ME
STRIPE_PRICE_ID=price_1U08lPIjMKrx5dSp2XBsn8to

# Error tracking. Public DSN, not a secret - Sentry org skald-and-stone, project kall-api.
SENTRY_DSN=https://PUBLIC_KEY@oORG.ingest.us.sentry.io/PROJECT_ID
SENTRY_ENVIRONMENT=production

# AI provider
OPENAI_API_KEY=REPLACE_ME
OPENAI_MODEL=gpt-5.6-luna
ALPHA_INVITE_ONLY=true
ALPHA_ALLOWED_EMAILS=REPLACE_WITH_OWNER_EMAIL

# Passkeys (WebAuthn). Must match the web app's real domain exactly, or every
# passkey registration/login will fail — there is no working default in production.
WEBAUTHN_RP_ID=app.example.com
WEBAUTHN_RP_NAME=Kall
WEBAUTHN_ORIGIN=https://app.example.com

# Single sign-on. Each is optional — omit a provider's pair to leave it disabled
# (its button greys out on /login and /register). Register redirect URIs as
# https://api.example.com/api/auth/oauth/{provider}/callback with each provider.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
MICROSOFT_OAUTH_CLIENT_ID=
MICROSOFT_OAUTH_CLIENT_SECRET=
LINKEDIN_OAUTH_CLIENT_ID=
LINKEDIN_OAUTH_CLIENT_SECRET=

# Web application build/runtime
NEXT_PUBLIC_API_URL=https://api.example.com
