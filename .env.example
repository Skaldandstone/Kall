APP_ENV=development
APP_SECRET_KEY=change-me
DATABASE_URL=sqlite:///./kall.db
FRONTEND_URL=http://localhost:3000
AUTO_CREATE_TABLES=true
SESSION_DAYS=30
PASSWORD_RESET_MINUTES=30
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna
ALPHA_INVITE_ONLY=false
ALPHA_ALLOWED_EMAILS=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=
STRIPE_PREMIUM_PRICE_ID=
STRIPE_PLUS_PRODUCT_ID=
STRIPE_PREMIUM_PRODUCT_ID=
STRIPE_PORTAL_CONFIGURATION_ID=
# Kall-only, unique per environment. No live payments in this release.
STRIPE_BILLING_SCOPE=
STRIPE_ENABLED=false
STRIPE_LIVEMODE=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
FCM_PROJECT_ID=
GOOGLE_APPLICATION_CREDENTIALS=
SENSITIVE_DATA_ENCRYPTION_KEY=

# Sentry error tracking. Leave blank locally - the SDK stays inert. The DSN
# is public by design (it can only send events to one project).
SENTRY_DSN=
SENTRY_ENVIRONMENT=

# Passkeys (WebAuthn). Defaults above work for localhost; override all three
# to match your real domain before deploying anywhere else.
WEBAUTHN_RP_ID=localhost
WEBAUTHN_RP_NAME=Kall
WEBAUTHN_ORIGIN=http://localhost:3000

# Single sign-on. Each provider is optional — leave a pair blank to disable it
# (its button greys out on /login and /register). Redirect URI to register
# with each provider: http://localhost:8000/api/auth/oauth/{provider}/callback
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
MICROSOFT_OAUTH_CLIENT_ID=
MICROSOFT_OAUTH_CLIENT_SECRET=
LINKEDIN_OAUTH_CLIENT_ID=
LINKEDIN_OAUTH_CLIENT_SECRET=
