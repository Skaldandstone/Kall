FROM python:3.12.14-alpine3.24@sha256:d81968c559557b881aa557ff6d1200acec8e72a2c85fcb4ad1806e8d13e09f0b AS runtime

# This API base contains the reviewed Alpine OpenSSL successor. Require its
# exact version so a future base refresh cannot be accepted silently.
ARG ALPINE_OPENSSL_APPROVED_VERSION
RUN set -eu; \
    apk add --no-cache --upgrade libuuid=2.42.3-r1; \
    apk info --exists "libuuid=2.42.3-r1"; \
    ! apk info --exists "libuuid=2.42.1-r0"; \
    test -n "${ALPINE_OPENSSL_APPROVED_VERSION}"; \
    test "${ALPINE_OPENSSL_APPROVED_VERSION}" = "3.5.8-r0"; \
    ! apk info --exists "libssl3=3.5.7-r0"; \
    ! apk info --exists "libcrypto3=3.5.7-r0"; \
    apk info --exists "libssl3=${ALPINE_OPENSSL_APPROVED_VERSION}"; \
    apk info --exists "libcrypto3=${ALPINE_OPENSSL_APPROVED_VERSION}"

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    HOME=/tmp \
    TMPDIR=/tmp \
    DATABASE_SSL_MODE=verify-full \
    DATABASE_SSL_ROOT_CERT=/etc/ssl/certs/aws-rds-us-east-2-bundle.pem

WORKDIR /app

COPY pyproject.toml ./
COPY backend ./backend
COPY migrations ./migrations
COPY alembic.ini ./
COPY deploy/certs/aws-rds-us-east-2-bundle.pem /etc/ssl/certs/aws-rds-us-east-2-bundle.pem

RUN python -m pip install --upgrade pip \
    && python -m pip install . \
    && addgroup -S -g 10001 kall \
    && adduser -S -D -H -u 10001 -G kall kall \
    && mkdir -p /app/uploads /app/generated \
    && chown 10001:10001 /app/uploads /app/generated \
    && chmod 0444 /etc/ssl/certs/aws-rds-us-east-2-bundle.pem

USER 10001:10001

EXPOSE 8000

HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=3 \
  CMD python -c "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8000/health', timeout=4)"

CMD ["uvicorn", "kall.main:app", "--host", "0.0.0.0", "--port", "8000", "--proxy-headers", "--forwarded-allow-ips", "*"]
