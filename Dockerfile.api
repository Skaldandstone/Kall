FROM python:3.12.14-alpine3.24@sha256:d09d15e60962ca365d1cd544a48773bac9d33f2fb1b00f2aa0deec78ade7dc31 AS runtime

# ECR found OpenSSL 3.5.7-r0 in the reviewed base. Keep builds blocked until
# Alpine publishes a successor and the exact installed version is reviewed.
ARG ALPINE_OPENSSL_APPROVED_VERSION
RUN set -eu; \
    ssl_version="$(apk info -v libssl3 | sed 's/^libssl3-//')"; \
    crypto_version="$(apk info -v libcrypto3 | sed 's/^libcrypto3-//')"; \
    test -n "${ALPINE_OPENSSL_APPROVED_VERSION}"; \
    test "${ssl_version}" != "3.5.7-r0"; \
    test "${crypto_version}" != "3.5.7-r0"; \
    test "${ssl_version}" = "${ALPINE_OPENSSL_APPROVED_VERSION}"; \
    test "${crypto_version}" = "${ALPINE_OPENSSL_APPROVED_VERSION}"

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    HOME=/tmp \
    TMPDIR=/tmp \
    DATABASE_SSL_MODE=verify-full \
    DATABASE_SSL_ROOT_CERT=/etc/ssl/certs/aws-rds-us-east-2-bundle.pem

WORKDIR /app

COPY pyproject.toml ./
COPY backend ./backend
COPY migrations ./migrations
COPY alembic.ini ./
COPY deploy/certs/aws-rds-us-east-2-bundle.pem /etc/ssl/certs/aws-rds-us-east-2-bundle.pem

RUN python -m pip install --upgrade pip \
    && python -m pip install . \
    && addgroup -S -g 10001 kall \
    && adduser -S -D -H -u 10001 -G kall kall \
    && mkdir -p /app/uploads /app/generated \
    && chown 10001:10001 /app/uploads /app/generated \
    && chmod 0444 /etc/ssl/certs/aws-rds-us-east-2-bundle.pem

USER 10001:10001

EXPOSE 8000

HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=3 \
  CMD python -c "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8000/health', timeout=4)"

CMD ["uvicorn", "kall.main:app", "--host", "0.0.0.0", "--port", "8000", "--proxy-headers", "--forwarded-allow-ips", "*"]
