# Nonsecret production-candidate configuration for Kall.
#
# Secrets are injected from AWS Secrets Manager by the ECS task definition.
# Do not put real values in this file, source archives, build arguments, logs,
# screenshots, reports, or chat.

APP_ENV=production
FRONTEND_URL=https://kall.skaldandstone.com
AUTO_CREATE_TABLES=false

AWS_REGION=us-east-2
AWS_S3_BUCKET=replace-with-reviewed-production-bucket

DATABASE_SSL_MODE=verify-full
DATABASE_SSL_ROOT_CERT=/etc/ssl/certs/aws-rds-us-east-2-bundle.pem
DB_HOST=replace-with-private-rds-hostname
DB_PORT=5432
DB_NAME=kall
DB_USER=kall_runtime

# The first production release remains invitation-only. Changing this is a
# separate public-launch decision and requires abuse, support, and capacity review.
ALPHA_INVITE_ONLY=true
CLERK_AUTHORIZED_PARTIES=https://kall.skaldandstone.com

OPENAI_MODEL=gpt-5.6-luna
MONITORING_ENABLED=false

# Sentry error tracking (org skald-and-stone). DSNs are public by design and
# are stack parameters (SentryApiDsn / SentryWebDsn), not Secrets Manager
# entries. Blank keeps the SDK inert.
SENTRY_DSN=https://b6c353e72db357895f4457d0ce25ed5a@o4512015786377216.ingest.us.sentry.io/4512018525585408
SENTRY_ENVIRONMENT=production
SES_SENDER_EMAIL=

# The production runtime accepts only live Stripe objects when LIVEMODE is
# true. Keep the feature disabled until the Kall-only live products, recurring
# prices, portal configuration and webhook endpoint have been created and
# verified. Automatic tax remains disabled until registrations are confirmed.
STRIPE_ENABLED=false
STRIPE_LIVEMODE=true
STRIPE_BILLING_SCOPE=kall:production
STRIPE_PRICE_ID=
STRIPE_PLUS_PRODUCT_ID=
STRIPE_PREMIUM_PRICE_ID=
STRIPE_PREMIUM_PRODUCT_ID=
STRIPE_PORTAL_CONFIGURATION_ID=

# Required secret-backed values. Names only, never values:
# APP_SECRET_KEY
# SENSITIVE_DATA_ENCRYPTION_KEY
# CLERK_SECRET_KEY
# The web image must be built with the production publishable key and:
# --build-arg KALL_CLERK_INSTANCE=production
# --build-arg NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=<Clerk production publishable key>
# DB_PASSWORD
# ALPHA_ALLOWED_EMAILS
#
# Required only when their feature gate is enabled:
# STRIPE_SECRET_KEY
# STRIPE_WEBHOOK_SECRET
# OPENAI_API_KEY
