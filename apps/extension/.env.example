# Build-time settings for `npm run build` (esbuild.config.mjs). Nothing here
# is read at runtime; the values are compiled into src/popup.bundle.js.
#
# Sentry DSN for the `kall-extension` project. Public by design (it can only
# send events to one project), so it is fine in a build environment. Leave it
# empty and the extension never loads the Sentry SDK at all. See
# docs/PRODUCTION_DEPLOYMENT.md section 3a.
SENTRY_DSN=

# Environment tag on reported events. Defaults to "production".
SENTRY_ENVIRONMENT=
